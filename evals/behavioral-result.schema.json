{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Delegate live behavioral result",
  "type": "object",
  "required": ["schema_version", "suite", "runtime", "runs"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "suite": {"const": "codex-delegate-live-behavior"},
    "runtime": {
      "type": "object",
      "required": ["codex_version", "date"],
      "properties": {
        "codex_version": {"type": "string", "minLength": 1},
        "date": {"type": "string", "minLength": 1},
        "platform": {"type": ["string", "null"]},
        "observed_child_capacity": {"type": ["integer", "null"], "minimum": 0},
        "child_progress_observability": {
          "type": ["string", "null"],
          "enum": [null, "none", "terminal_only", "periodic_summary", "structured_live"]
        }
      },
      "additionalProperties": true
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "workload_id",
          "mode",
          "pair_id",
          "repeat_index",
          "repo_revision",
          "workload_definition_hash",
          "main_session_route",
          "worker_route",
          "permissions_fingerprint",
          "tool_surface_fingerprint",
          "acceptance_rubric_id",
          "success",
          "agent_count",
          "roles",
          "decision"
        ],
        "properties": {
          "workload_id": {"type": "string", "minLength": 1},
          "mode": {
            "enum": [
              "main_session_only",
              "raw_prompt_luna",
              "contract_luna",
              "contract_luna_selective_sol",
              "contract_luna_final_review_gate",
              "contract_delta_terra",
              "adaptive_orchestration",
              "external_baseline"
            ]
          },
          "pair_id": {"type": "string", "minLength": 1},
          "repeat_index": {"type": "integer", "minimum": 1},
          "repo_revision": {"type": "string", "minLength": 1},
          "workload_definition_hash": {"type": "string", "minLength": 1},
          "main_session_route": {"type": "string", "minLength": 1},
          "worker_route": {"type": ["string", "null"]},
          "permissions_fingerprint": {"type": "string", "minLength": 1},
          "tool_surface_fingerprint": {"type": "string", "minLength": 1},
          "acceptance_rubric_id": {"type": "string", "minLength": 1},
          "success": {"type": "boolean"},
          "acceptance_score": {"type": ["number", "null"], "minimum": 0},
          "decision": {"type": "string"},
          "agent_count": {"type": "integer", "minimum": 0},
          "peak_active_children": {"type": ["integer", "null"], "minimum": 0},
          "ready_dependencies": {"type": ["integer", "null"], "minimum": 0},
          "dependency_ids": {"type": "array", "items": {"type": "string"}},
          "runtime_slot_waits": {"type": "integer", "minimum": 0},
          "roles": {"type": "array", "items": {"type": "string"}},
          "route_evidence_grade": {"type": ["string", "null"]},
          "policy_violations": {"type": "array", "items": {"type": "string"}},
          "scope_violations": {"type": "integer", "minimum": 0},
          "wrong_edits": {"type": "integer", "minimum": 0},
          "regressions": {"type": "integer", "minimum": 0},
          "correction_turns": {"type": "integer", "minimum": 0},
          "execution_stall_events": {"type": "integer", "minimum": 0},
          "clean_same_lane_restarts": {"type": "integer", "minimum": 0},
          "unjustified_retry_calls": {"type": "integer", "minimum": 0},
          "same_failure_without_new_evidence": {"type": "integer", "minimum": 0},
          "intervention_gate_evaluations": {"type": "integer", "minimum": 0},
          "interventions_taken": {"type": "integer", "minimum": 0},
          "recovery_ledger_entries": {"type": "integer", "minimum": 0},
          "attempt_cycle_detected": {"type": ["boolean", "null"]},
          "proposed_recovery_action": {"type": ["string", "null"]},
          "effective_recovery_action": {"type": ["string", "null"]},
          "recovery_decision_source": {
            "type": ["string", "null"],
            "enum": [null, "deterministic_evidence", "main_session_judgment", "user_decision", "runtime_constraint", "model_judgment"]
          },
          "policy_transform": {"type": ["string", "null"]},
          "child_progress_observability": {
            "type": ["string", "null"],
            "enum": [null, "none", "terminal_only", "periodic_summary", "structured_live"]
          },
          "main_session_correction_tokens": {"type": ["integer", "null"], "minimum": 0},
          "main_session_correction_ms": {"type": ["integer", "null"], "minimum": 0},
          "review_findings": {"type": "integer", "minimum": 0},
          "review_caught_material_issue": {"type": ["boolean", "null"]},
          "review_false_positives": {"type": "integer", "minimum": 0},
          "final_review_requirement": {
            "type": ["string", "null"],
            "enum": [null, "not_required", "required"]
          },
          "final_review_trigger_reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "final_review_attempts": {"type": "integer", "minimum": 0},
          "final_review_verdict": {
            "type": ["string", "null"],
            "enum": [null, "ship", "fix-first", "rethink", "incomplete", "declined"]
          },
          "final_review_gate_satisfied": {"type": ["boolean", "null"]},
          "review_artifact_verify_failures": {"type": "integer", "minimum": 0},
          "post_review_mutations": {"type": "integer", "minimum": 0},
          "consent_prompts": {"type": "integer", "minimum": 0},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
          "latency_ms": {"type": ["integer", "null"], "minimum": 0},
          "evidence_established": {"type": "integer", "minimum": 0},
          "evidence_invalidated": {"type": "integer", "minimum": 0},
          "unjustified_repeated_commands": {"type": "integer", "minimum": 0},
          "unjustified_repeated_discovery": {"type": "integer", "minimum": 0},
          "duplicate_dependency_calls": {"type": "integer", "minimum": 0},
          "notes": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "enum": [
                    "raw_prompt_luna",
                    "contract_luna",
                    "contract_luna_selective_sol",
                    "contract_luna_final_review_gate"
                  ]
                }
              },
              "required": ["mode"]
            },
            "then": {
              "properties": {
                "worker_route": {"type": "string", "minLength": 1}
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
