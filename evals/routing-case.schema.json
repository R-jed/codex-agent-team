{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Agent Team orchestration cases",
  "type": "object",
  "required": ["schema_version", "skill_name", "evals"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "skill_name": {"const": "codex-agent-team"},
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "input", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "enum": ["delegation", "contractability", "routing", "escalation", "consent", "safety", "lifecycle"]
          },
          "input": {"type": "object"},
          "expected": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {"enum": ["main_session", "delegate", "ask_consent", "reject_result"]},
              "nodes": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["responsibility", "model", "effort", "write_intent", "workspace", "fork_turns", "agent_type", "route_assurance"],
                  "properties": {
                    "responsibility": {"enum": ["reader", "worker", "investigator", "advisor"]},
                    "model": {"enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]},
                    "effort": {"enum": ["high", "xhigh", "max"]},
                    "write_intent": {"type": "boolean"},
                    "workspace": {"type": "string"},
                    "fork_turns": {"type": "string", "pattern": "^(none|[1-9][0-9]*)$"},
                    "agent_type": {"enum": ["codex_agent_team_reader", "codex_agent_team_worker", "codex_agent_team_investigator", "codex_agent_team_advisor"]},
                    "route_assurance": {"const": "profile_locked"},
                    "unresolved_delta_only": {"type": "boolean"}
                  },
                  "additionalProperties": true
                }
              },
              "failure_class": {"type": ["string", "null"], "enum": [null, "mechanical_defect", "contract_gap", "capability_gap", "judgment_gap"]},
              "consent_reason": {"type": ["string", "null"]},
              "main_reason": {"type": ["string", "null"]},
              "policy_violation": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
