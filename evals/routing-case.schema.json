{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Delegate Routing V4 cases",
  "type": "object",
  "required": ["schema_version", "skill_name", "evals"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "skill_name": {"const": "codex-delegate"},
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "input", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "delegation",
              "classification",
              "main_coverage",
              "routing",
              "reclassification",
              "consent",
              "safety",
              "lifecycle",
              "progress"
            ]
          },
          "input": {"type": "object"},
          "expected": {
            "type": "object",
            "required": ["action"],
            "properties": {
              "action": {"enum": ["main_session", "delegate", "ask_consent", "reject_result", "queue"]},
              "dependency_kind": {
                "type": ["string", "null"],
                "enum": [null, "evidence", "bounded_execution", "judgment", "judgment_coupled_execution", "technical_investigation"]
              },
              "main_judgment_coverage": {
                "type": ["string", "null"],
                "enum": [null, "covered", "uncovered", "unknown"]
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["dependency_id", "responsibility", "model", "effort", "write_intent", "workspace", "fork_turns", "agent_type", "route_assurance"],
                  "properties": {
                    "dependency_id": {"type": "string", "minLength": 1},
                    "responsibility": {"enum": ["reader", "worker", "solver", "investigator", "advisor"]},
                    "model": {"enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]},
                    "effort": {"enum": ["high", "xhigh", "max"]},
                    "write_intent": {"type": "boolean"},
                    "workspace": {"type": "string"},
                    "fork_turns": {"type": "string", "pattern": "^(none|[1-9][0-9]*)$"},
                    "agent_type": {
                      "enum": [
                        "codex_delegate_reader",
                        "codex_delegate_worker",
                        "codex_delegate_solver",
                        "codex_delegate_investigator",
                        "codex_delegate_advisor"
                      ]
                    },
                    "route_assurance": {"const": "profile_locked"},
                    "unresolved_delta_only": {"type": "boolean"},
                    "clean_restart": {"type": "boolean"}
                  },
                  "additionalProperties": true
                }
              },
              "stop_reason": {
                "type": ["string", "null"],
                "enum": [null, "CONTRACT_GAP", "JUDGMENT_REQUIRED", "TECHNICAL_GAP", "EXECUTION_STALL"]
              },
              "progress_signal": {"type": ["string", "null"], "enum": [null, "advanced", "unchanged", "regressed", "blocked"]},
              "reclassified_from": {
                "type": ["string", "null"],
                "enum": [null, "evidence", "bounded_execution", "judgment", "judgment_coupled_execution", "technical_investigation"]
              },
              "reclassified_to": {
                "type": ["string", "null"],
                "enum": [null, "evidence", "bounded_execution", "judgment", "judgment_coupled_execution", "technical_investigation"]
              },
              "consent_reason": {"type": ["string", "null"]},
              "main_reason": {"type": ["string", "null"]},
              "policy_violation": {"type": ["string", "null"]},
              "queued_dependencies": {"type": "array", "items": {"type": "string"}},
              "independent_review_required": {"type": ["boolean", "null"]}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
