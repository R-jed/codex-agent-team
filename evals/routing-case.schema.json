{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Agent Team routing evals",
  "type": "object",
  "required": [
    "schema_version",
    "skill_name",
    "evals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_name": {
      "const": "codex-agent-team"
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "delegation",
              "routing",
              "capability",
              "consent",
              "safety",
              "lifecycle"
            ]
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "root",
                  "delegate",
                  "ask_consent",
                  "reject_result"
                ]
              },
              "workers": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "responsibility",
                    "model",
                    "effort",
                    "write_intent",
                    "workspace",
                    "fork_turns",
                    "route_mode",
                    "agent_type"
                  ],
                  "properties": {
                    "responsibility": {
                      "enum": [
                        "explorer",
                        "execution_worker",
                        "independent_critic",
                        "senior_judge"
                      ]
                    },
                    "model": {
                      "enum": [
                        "gpt-5.6-luna",
                        "gpt-5.6-terra",
                        "gpt-5.6-sol"
                      ]
                    },
                    "effort": {
                      "enum": [
                        "high",
                        "xhigh",
                        "max"
                      ]
                    },
                    "write_intent": {
                      "type": "boolean"
                    },
                    "workspace": {
                      "type": "string"
                    },
                    "fork_turns": {
                      "type": "string",
                      "pattern": "^(none|[1-9][0-9]*)$"
                    },
                    "route_mode": {
                      "type": "string",
                      "enum": [
                        "portable",
                        "profile"
                      ]
                    },
                    "agent_type": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": true
                }
              },
              "consent_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "root_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "policy_violation": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
