{
  "schema_version": "1.0",
  "suite": "subagents-dispatch-coordination-contract",
  "cases": [
    {
      "id": "upstream-workflow-remains-authoritative",
      "input": {
        "task": "An upstream Skill already defines goal, stages, outputs, dependencies, and acceptance. Delegate useful execution without changing that workflow."
      },
      "expected": {
        "preserve_upstream_workflow": true,
        "delegate_may_assign": ["owner", "role", "concurrency", "write_isolation", "integration_timing"],
        "delegate_must_not_redefine": ["goal", "decomposition", "stage_order", "dependencies", "required_outputs", "business_acceptance", "quality_gates"]
      }
    },
    {
      "id": "isolated-files-shared-api-are-not-independent",
      "input": {
        "task": "Two proposed writers use separate physical checkouts and disjoint files, but one changes an API contract that the other consumes."
      },
      "expected": {
        "parallel_writes_allowed": false,
        "reason": "semantic_dependency",
        "filesystem_isolation_sufficient": false,
        "required_resolution": "explicit_dependency_or_integration_order"
      }
    },
    {
      "id": "verify-child-cannot-fix-source",
      "input": {
        "task": "A verification child discovers a source defect while checking acceptance."
      },
      "expected": {
        "intent": "verify",
        "mutation_authority": "none",
        "source_write_allowed": false,
        "on_required_source_change": "return_to_main_for_authority"
      }
    },
    {
      "id": "declared-output-does-not-grant-source-write",
      "input": {
        "task": "A child may update one named verification report but otherwise only inspects source."
      },
      "expected": {
        "intent": "verify",
        "mutation_authority": "declared-output-only",
        "source_write_allowed": false,
        "declared_output_write_allowed": true
      }
    },
    {
      "id": "independent-execution-ordered-integration",
      "input": {
        "task": "Two isolated writers implement against an already-stable interface. Both can make progress now, but the consumer result must be integrated only after the producer result is accepted."
      },
      "expected": {
        "execution_can_overlap": true,
        "consumer_integration_after": ["producer"],
        "main_is_integration_owner": true,
        "integrate_by_completion_time": false
      }
    },
    {
      "id": "unresolved-semantics-cannot-hide-behind-integration-order",
      "input": {
        "task": "A consumer implementation depends on an API behavior decision that has not been made yet."
      },
      "expected": {
        "ready_to_execute": false,
        "integration_after_is_sufficient": false,
        "reason": "semantic_truth_not_ready"
      }
    },
    {
      "id": "accepted-route-is-not-runtime-observation",
      "input": {
        "task": "The host accepted the requested child role and model, but it did not expose runtime model or effort telemetry."
      },
      "expected": {
        "requested_status": "declared",
        "accepted_status": "matched",
        "observed_status": "not_observed",
        "may_claim_observed_route": false
      }
    }
  ]
}
