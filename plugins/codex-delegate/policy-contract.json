{
  "schema_version": 2,
  "delegation": {
    "max_depth": 1,
    "baseline_concurrent_children": 2,
    "max_active_writers_per_workspace": 1
  },
  "classification": {
    "dependency_kinds": [
      "evidence",
      "bounded_execution",
      "judgment",
      "judgment_coupled_execution",
      "technical_investigation"
    ],
    "main_judgment_coverage": ["covered", "uncovered", "unknown"],
    "main_coverage_reference_role": "solver",
    "reasoning_effort_order": ["minimal", "low", "medium", "high", "xhigh", "max"]
  },
  "roles": {
    "reader": {
      "profile_file": "codex-delegate-reader.toml",
      "agent_type": "codex_delegate_reader",
      "model": "gpt-5.6-luna",
      "effort": "max",
      "sandbox_intent": "read-only"
    },
    "worker": {
      "profile_file": "codex-delegate-worker.toml",
      "agent_type": "codex_delegate_worker",
      "model": "gpt-5.6-luna",
      "effort": "max",
      "sandbox_intent": "workspace-write"
    },
    "solver": {
      "profile_file": "codex-delegate-solver.toml",
      "agent_type": "codex_delegate_solver",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "sandbox_intent": "workspace-write"
    },
    "investigator": {
      "profile_file": "codex-delegate-investigator.toml",
      "agent_type": "codex_delegate_investigator",
      "model": "gpt-5.6-terra",
      "effort": "xhigh",
      "sandbox_intent": "read-only"
    },
    "advisor": {
      "profile_file": "codex-delegate-advisor.toml",
      "agent_type": "codex_delegate_advisor",
      "model": "gpt-5.6-sol",
      "effort": "high",
      "sandbox_intent": "read-only"
    }
  },
  "final_review": {
    "trigger_codes": [
      "user_requested",
      "public_contract_change",
      "persistent_state_change",
      "security_boundary",
      "authorization_boundary",
      "data_integrity",
      "concurrency_semantics",
      "migration",
      "verification_gap"
    ],
    "completion_verdicts": ["ship", "fix-first", "rethink"],
    "unresolved_verdict": "insufficient_evidence"
  }
}
